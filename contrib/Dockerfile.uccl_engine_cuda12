# NIXL manylinux 轮子构建容器：UCCL 传输后端（CUDA 12，引擎源码编译版）。
# 前身为三引擎版 Dockerfile.manylinux_ucx_uccl_mooncake_cuda12（UCX+UCCL+
# Mooncake），随 UCX 与 Mooncake 及其专属依赖裁剪更名；现主要角色：为两步
# 流程（contrib/build-wheels-uccl-cu12.sh 步骤一）从源码编译含 libuccl_p2p
# 的 wheel_base 基座（基座层冻结：仅引擎 commit/依赖变化才动）。
#
# 结构同官方 contrib/Dockerfile.manylinux：CUDA donor 把 toolkit 移植到
# PyPA manylinux_2_28（AlmaLinux 8 / glibc 2.28）基座上，再用官方 contrib/
# build-wheel.sh 按 3.10-3.14 全矩阵产出 manylinux_2_28 平台 tag 的自包含
# 轮子；manylinux 基座 tag 与官方一致，CUDA 钉 12.4（理由见下方约束）。
# 引擎集合钉住 UCCL 一个插件（本分支 all_plugins 只有 'UCCL'，enable_plugins
# 填其他名字 meson 直接报错），只构建 UCCL 需要的依赖。
#
# 传输能力（UCCL 单引擎）：RDMA——UCCL 默认 RDMA 传输（ibverbs 库运行时
# dlopen，目标机自备 libibverbs/libefa 等；头文件是编译期硬依赖，见下方
# dnf 层）；NVLink——CUDA-IPC 本地路径（节点内 GPU P2P）。
#
# CUDA 12 特有约束：nvcc 12.4 最高 sm_90，架构列表固定 80,86,89,90
# （nixl_cuda_arch_list 的 "auto" 默认值 80..120 会构建失败）。meta 轮子
# （nixl-*-py3-none-any.whl）只随 cu12 产出、-Drelease_wheel=true 构建
# （钉 nixl-cu12 与 nixl-cu13 两个依赖），同官方 cu12/cu13 分工。
#
# 网络（国内）：dnf 华为云、uv/PyPI 清华 TUNA、github 断流靠重试；不装
# torch。基础镜像（quay.io manylinux、nvcr.io CUDA donor）无国内镜像，
# 拉取慢属正常。
#
# 版本对齐：UCCL 引擎 commit 取自 NIXL v1.5.0 的 CI（.gitlab/build.sh）。
#
# 用法（在仓库根目录执行；推荐直接跑编排脚本 bash contrib/build-wheels-uccl-cu12.sh）：
#   docker build -f contrib/Dockerfile.uccl_engine_cuda12 \
#       -t nixl-wheel-base:uccl-cu12 --target wheel_base .    # 两步流程：只建基座
#   docker build -f contrib/Dockerfile.uccl_engine_cuda12 -t nixl-wheels:cu12 .    # 或整建（基座+轮子一步）
#   docker cp $(docker create nixl-wheels:cu12):/workspace/nixl/dist .
# 可选：--build-arg WHL_PYTHON_VERSIONS=3.12 缩小矩阵（版本必须是镜像
#   /opt/python 自带的，轮子层有 fail-fast 检查；--build-arg wheel_base=<已
#   构建镜像> 可复用基座层，见官方 build-container.sh 的 --wheel-base-image）。
ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY
ARG ARCH="x86_64"
# CUDA toolkit donor：只 COPY 其 /usr/local/cuda。官方 manylinux 用 el8/ubi8
# 味 donor 匹配 AlmaLinux 8 基座；ubuntu 味同样可行——CUDA 12.4 原生支持
# RHEL 8，同一套 toolkit 二进制也打进 RHEL8 包，在 glibc 2.28 上可运行
# （donor 的 OS 包一概不继承）。万一 nvcc 报 "GLIBC_2.xx not found"，
# --build-arg BASE_IMAGE_TAG=12.4.1-devel-ubi8 换回 el8 味即可。
ARG BASE_IMAGE="nvcr.io/nvidia/cuda"
ARG BASE_IMAGE_TAG="12.4.1-devel-ubuntu22.04"
ARG MANYLINUX_IMAGE="quay.io/pypa/manylinux_2_28"
ARG MANYLINUX_IMAGE_TAG="2026.06.06-1"
# 覆盖为某个已发布的 wheel_base 镜像 URL 时，跳过本地构建基座层（CI 缓存）。
ARG wheel_base=wheel_base

# --- 阶段一：CUDA donor（只取 toolkit） -------------------------------------------------
FROM ${BASE_IMAGE}:${BASE_IMAGE_TAG} AS cuda

# --- 阶段二：manylinux 构建基座（系统依赖 + UCCL 引擎） ---------------------------------
FROM ${MANYLINUX_IMAGE}_${ARCH}:${MANYLINUX_IMAGE_TAG} AS wheel_base

ARG ARCH="x86_64"
ARG NPROC
ARG DEFAULT_PYTHON_VERSION="3.12"
ARG CUDA_VERSION="12.4"

# --- 版本/路径（--build-arg 可覆盖） ----------------------------------------------------
ARG UCCL_REPO="https://github.com/uccl-project/uccl.git"
# NIXL v1.5.0 的 CI（.gitlab/build.sh）固定的 commit。该版插件用了变长通知
# API（uccl_engine_send_notif_v / uccl_engine_get_notifs_v），旧的 0cdb740c
# 引擎没有这些接口、编不过，不能回退。
ARG UCCL_REF="da914a2054c29725464803e379bb3b98de90dfa1"

# CUDA toolkit onto the manylinux base（同官方 Dockerfile.manylinux）。
COPY --from=cuda /usr/local/cuda /usr/local/cuda
RUN ln -sfn /usr/local/cuda /usr/local/cuda-${CUDA_VERSION}
ENV CUDA_HOME=/usr/local/cuda \
    PATH=/usr/local/cuda/bin:${PATH} \
    LD_LIBRARY_PATH=/usr/local/cuda/lib64:/usr/local/cuda/lib64/stubs:${LD_LIBRARY_PATH:-}
# el8 默认 gcc 8 太旧（UCCL 要 C++20），且 CUDA 需要 gcc <= 14——钉
# gcc-toolset-14 到 PATH 前面（同官方 manylinux 镜像）。
ENV PATH=/opt/rh/gcc-toolset-14/root/usr/bin:${PATH} \
    LD_LIBRARY_PATH=/opt/rh/gcc-toolset-14/root/usr/lib64:${LD_LIBRARY_PATH:-}

# --- dnf 换源：华为云（AlmaLinux 全套 repo + EPEL） ----------------------------------
# sed 放在 dnf install 之前（首次元数据下载即走镜像）、install 后幂等二跑
# （兜住 almalinux-release-synergy 新增的 repo 文件）。要点：
# - baseurl 替换必须把 repo.almalinux.org 自带的 /almalinux/ 路径一并吃掉，
#   否则拼出 mirrors.huaweicloud.com/almalinux/almalinux/... 下层 404。
# - EPEL：自带 epel.repo 只有 metalink 行、sed 不可靠——整文件重写为镜像
#   源（gpgkey 用 epel-release 装进来的密钥；testing/modular 用不到、删掉）。
# - grep 断言确认换源真的发生；powertools/CRB 双名兜底启用（boost-devel 在
#   CRB；synergy 装上时会自行启用，这里只是保险），都不在则终止。
# - dnf.conf：并发 10 + timeout=30/minrate=10000（低于 10KB/s 持续 30s 掐断
#   涓流连接）+ retries=20（掐断后自动重传）。
# - 层首尾各 clean all：清掉基座自带的旧 /var/cache/dnf，不做跨层元数据缓存
#   捷径（基座旧 zck 跨层增量属未定义行为，解析类故障不可复现）。
RUN set -eux; \
    printf 'max_parallel_downloads=10\ntimeout=30\nminrate=10000\nretries=20\n' >> /etc/dnf/dnf.conf; \
    dnf clean all; \
    sed -i -E \
        -e 's|^mirrorlist=|#mirrorlist=|g' \
        -e 's|^#*[[:space:]]*baseurl=https?://repo[.]almalinux[.]org/almalinux|baseurl=https://mirrors.huaweicloud.com/almalinux|g' \
        /etc/yum.repos.d/almalinux*.repo; \
    dnf install -y dnf-plugins-core almalinux-release-synergy epel-release; \
    sed -i -E \
        -e 's|^mirrorlist=|#mirrorlist=|g' \
        -e 's|^#*[[:space:]]*baseurl=https?://repo[.]almalinux[.]org/almalinux|baseurl=https://mirrors.huaweicloud.com/almalinux|g' \
        /etc/yum.repos.d/almalinux*.repo; \
    printf '%s\n' \
        '[epel]' \
        'name=Extra Packages for Enterprise Linux 8 - $basearch' \
        'baseurl=https://mirrors.huaweicloud.com/epel/8/Everything/$basearch/' \
        'enabled=1' \
        'gpgcheck=1' \
        'gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-EPEL-8' \
        > /etc/yum.repos.d/epel.repo; \
    rm -f /etc/yum.repos.d/epel-testing.repo /etc/yum.repos.d/epel-testing-modular.repo \
          /etc/yum.repos.d/epel-modular.repo; \
    grep -q 'mirrors.huaweicloud.com/almalinux' /etc/yum.repos.d/almalinux*.repo; \
    grep -q 'mirrors.huaweicloud.com/epel' /etc/yum.repos.d/epel.repo; \
    dnf config-manager --set-enabled powertools \
        || dnf config-manager --set-enabled crb \
        || { echo 'ERROR: powertools/CRB repo not found'; exit 1; }; \
    dnf clean all

# UCCL p2p 构建依赖：-lz -lelf；cxi 传输无条件编译、需 libfabric 公共头
# （仅编译期，运行时 dlopen 不进 DT_NEEDED）；libibverbs-devel 提供头文件
# ——上游 util/common.h 无条件 #include <infiniband/efadv.h>，虽运行库不进
# DT_NEEDED，头文件缺了各 .cc 连带全灭（拖进来的 libibverbs 运行库只留在
# 构建容器，轮子形状不变）；python3-devel 供上游 Makefile 的 python3-config
# 探测（显式装上、不靠别的包偶然拖进来）；curl 供 wrap 预下载层用。
# el8 包名正名：gcc-toolset-14-g++/libelf-devel 是 RHEL10 时代的名，el8
# 只有 gcc-toolset-14-gcc-c++ / elfutils-libelf-devel。UCX/Mooncake 及其
# 专属依赖已随引擎一并移除。
RUN dnf install -y \
    gcc-toolset-14 gcc-toolset-14-gcc-c++ \
    make \
    ccache \
    git curl ca-certificates pkgconf-pkg-config \
    python3-devel \
    zlib-devel elfutils-libelf-devel libfabric-devel \
    libibverbs-devel \
    && dnf clean all && rm -rf /var/cache/dnf

# --- Python 工具链（uv；主 venv 放 /workspace/.venv） -----------------------------------
# 不用 `COPY --from=ghcr.io/astral-sh/uv:latest`：BuildKit 每次构建都要连
# ghcr.io 解析镜像元数据（即使本层已缓存），国内直连常 TLS 超时卡死构建。
# 改用镜像自带 cp 解释器的 pip 从 PyPI 装 uv（--prefix 落进默认 PATH；
# -i TUNA——uv 尚未就位，读不到 UV_DEFAULT_INDEX）。
RUN PYS="cp$(echo ${DEFAULT_PYTHON_VERSION} | tr -d .)" && \
    /opt/python/${PYS}-${PYS}/bin/python${DEFAULT_PYTHON_VERSION} -m pip install \
        --no-cache-dir --prefix=/usr/local \
        -i https://pypi.tuna.tsinghua.edu.cn/simple uv

ENV UV_CACHE_DIR=/workspace/.cache/uv
RUN mkdir -p $UV_CACHE_DIR
# 从 TUNA 拉构建工具时单连接偶发长时间停滞：放宽 uv 默认 30s 的 HTTP 超时、
# 降低并发让每连接分到更多带宽。
ENV UV_HTTP_TIMEOUT=600 \
    UV_CONCURRENT_DOWNLOADS=8 \
    UV_DEFAULT_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple

# /opt/python 的解释器软链进 /usr/local/bin：uv venv --python 3.X 在
# only-system 偏好下解析到它们，全程零解释器下载（uv 默认去 github 拉
# "托管"解释器，国内直连不稳）。
RUN echo "bundled pythons: $(ls /opt/python | sort | tr '\n' ' ')" && \
    for py in /opt/python/cp*/bin/python3.*; do \
        [ -x "$py" ] || continue; \
        ln -sf "$py" "/usr/local/bin/$(basename $py)"; \
    done

# 主 venv：原生 meson 构建与轮子层共用；nanobind 为 UCCL p2p 的 python
# 扩展、auditwheel/tomlkit 是 build-wheel.sh 调用的。解释器取镜像自带 cp312。
RUN PYS="cp$(echo ${DEFAULT_PYTHON_VERSION} | tr -d .)" && \
    uv venv /workspace/.venv --python /opt/python/${PYS}-${PYS}/bin/python${DEFAULT_PYTHON_VERSION} && \
    uv pip install --python /workspace/.venv/bin/python --upgrade \
    meson meson-python ninja pybind11 patchelf pyYAML click tabulate tomlkit \
    auditwheel nanobind 'setuptools>=80.9.0' types-PyYAML
ENV VIRTUAL_ENV=/workspace/.venv
ENV PATH=/workspace/.venv/bin:${PATH}

# --- UCCL P2P 引擎 ----------------------------------------------------------------------
# libuccl_p2p.so + uccl_engine.h 装进 /usr/local，NIXL UCCL 插件经
# find_library('uccl_p2p') 解析；el8 的 ldconfig 默认不搜 /usr/local/lib
# ——同层注册之，轮子层 auditwheel repair 与运行期 dlopen 都靠它。CUDA 只
# 构建期需要，driver-API stub 软链到 Makefile 预期 -lcuda 的位置；各传输
# 运行时 dlopen，编译期头文件（ibverbs/efadv.h、cxi 的 libfabric 头）见
# 前面 dnf 层；编译命令里的 -I/opt/amazon/efa、-I/opt/libfabric 指向容器
# 中不存在的路径，缺失 -I 目录无害。
# 链接关键（PYTHON_LDFLAGS/PYTHON_LIB 命令行覆盖 + readelf 断言）：引擎
# 核心无条件引用 PyGILState_Ensure/PyErr_CheckSignals（轮询循环里查
# Ctrl-C）——Linux 扩展惯例不链 libpython、Py* 符号由宿主解释器解析（两者
# 均为 limited-API 稳定函数，3.10-3.14 宿主通用）；而上游 Makefile 会从
# 平台 python3-config（el8 是 3.6m ABI 变体）拼出系统不存在的
# -lpython3.6m——命令行变量压过 Makefile 内赋值（经 MAKEFLAGS 传给子
# make），把 -lpython* 从 libuccl_p2p.so 与 p2p.abi3.so 两条链接里整个
# 拿掉，保留非 python 尾巴 -lpthread -ldl -lutil -lm。CXX 加
# -Wl,--as-needed 挡未引用库（libutil/libz/libelf 不进 DT_NEEDED）；
# install 后 readelf 断言 DT_NEEDED 无 libpython——上游 Makefile 漂移时在
# 本层报错，不把带平台 3.6m libpython 的坏轮子发出去。
RUN [ -e /usr/local/cuda/lib64/libcuda.so ] || \
        ln -s /usr/local/cuda/lib64/stubs/libcuda.so /usr/local/cuda/lib64/libcuda.so; \
    cd /tmp && \
    for i in 1 2 3 4 5; do \
        rm -rf uccl && git clone ${UCCL_REPO} uccl && break; \
        echo "=== uccl clone attempt $i failed, retrying in 10s ==="; sleep 10; \
    done && \
    test -d uccl/.git && \
    cd uccl && git checkout ${UCCL_REF} && \
    cd p2p && \
    make -j${NPROC:-$(nproc)} CXX="g++ -Wl,--as-needed" \
        PYTHON_LDFLAGS="-lpthread -ldl -lutil -lm" PYTHON_LIB= && \
    make install CXX="g++ -Wl,--as-needed" \
        PYTHON_LDFLAGS="-lpthread -ldl -lutil -lm" PYTHON_LIB= && \
    test -f /usr/local/lib/libuccl_p2p.so && \
    if readelf -d /usr/local/lib/libuccl_p2p.so | grep libpython; then \
        echo 'ERROR: libuccl_p2p.so 的 DT_NEEDED 仍含 libpython（PYTHON_LDFLAGS/PYTHON_LIB 覆盖失效？）'; \
        exit 1; \
    fi && \
    echo /usr/local/lib > /etc/ld.so.conf.d/uccl-p2p.conf && \
    ldconfig && \
    cd /tmp && rm -rf uccl

# nvcc 12.4 的宿主编译器只支持到 GCC 13.2，PATH 前置的 gcc-toolset-14(14.2)
# 会被 cudafe #error 拒绝（官方 CUDA 13 donor 无此问题）。在 PATH 里唯一
# 先于 /usr/local/cuda/bin 的位置（venv bin）放 nvcc 包装脚本，-ccbin 钉到
# gcc-toolset-12（基座自带，12.2 且 C++20 完整），退回 /usr/bin/gcc，皆无
# 则本层报错；层内空 kernel 冒烟＝meson sanity 前置（本分支 src/ 无 .cu，
# ccbin 只服务 sanity）。基座只带 toolset-12 的 C 件、缺 cc1plus——本层
# 开头层内 dnf 补 gcc-toolset-12-gcc-c++（既装且证，主 dnf 层缓存不动）。
RUN dnf install -y gcc-toolset-12-gcc-c++ \
    && dnf clean all && rm -rf /var/cache/dnf && \
    if [ -x /opt/rh/gcc-toolset-12/root/usr/bin/gcc ]; then \
        CCBIN=/opt/rh/gcc-toolset-12/root/usr/bin/gcc; \
    elif [ -x /usr/bin/gcc ]; then \
        CCBIN=/usr/bin/gcc; \
    else \
        echo 'ERROR: 找不到 CUDA 12.4 可用的宿主 gcc（gcc-toolset-12 或系统 gcc）'; \
        exit 1; \
    fi && \
    printf '#!/bin/sh\nexec /usr/local/cuda/bin/nvcc -ccbin %s "$@"\n' "$CCBIN" \
        > /workspace/.venv/bin/nvcc && \
    chmod +x /workspace/.venv/bin/nvcc && \
    printf '__global__ void smoke() {}\n' > /tmp/nvcc_smoke.cu && \
    nvcc -c /tmp/nvcc_smoke.cu -o /tmp/nvcc_smoke.o && \
    rm -f /tmp/nvcc_smoke.cu /tmp/nvcc_smoke.o && \
    echo "nvcc wrapper OK (ccbin=$CCBIN)"

WORKDIR /workspace

# --- 阶段三：NIXL 轮子 ------------------------------------------------------------------
FROM $wheel_base AS wheel

ARG ARCH="x86_64"
ARG NPROC
ARG DEFAULT_PYTHON_VERSION="3.12"
ARG NIXL_PLUGINS="UCCL"
ARG NIXL_PREFIX="/usr/local/nixl"
# el8 的 64 位库在 lib64（非 ubuntu 的 lib/<arch>-linux-gnu）。
ARG NIXL_PLUGIN_DIR="${NIXL_PREFIX}/lib64/plugins"
# nvcc 12.4 最高 sm_90；"auto"（80..120）会构建失败。
ARG CUDA_ARCH_LIST="80,86,89,90"

WORKDIR /workspace/nixl
# 分层 COPY 代替整仓 COPY .：只有这些文件变化才重跑其后的层。pyproject 的
# readme/license-files 要求 README.md 与 LICENSE 在（本分支 license-files
# 只有根 LICENSE）；subprojects/ 的 .wrap 见下方预下载层。
COPY meson.build meson_options.txt pyproject.toml README.md LICENSE ./
COPY subprojects ./subprojects
# 三个 wrap（abseil-cpp / asio（均 tarball + patch zip）/ tomlplusplus）
# 预下载进 subprojects/packagecache/（meson 优先读缓存且校验哈希，命中即
# 跳过下载）——否则下载发生在 meson setup 层，源码每改一次重下一遍。URL
# 用 wrapdb release 官方再托管（github /archive 按需重打包、哈希不稳定）；
# 升级 .wrap 须同步更新本层 URL/哈希。本层紧跟 COPY subprojects：.wrap 不
# 变则永久缓存。各重试 5 次，失败单独重跑本层即可（后续层全部命中缓存）。
RUN mkdir -p subprojects/packagecache && cd subprojects/packagecache && \
    for spec in \
      "https://github.com/mesonbuild/wrapdb/releases/download/abseil-cpp_20250814.1-1/abseil-cpp-20250814.1.tar.gz|abseil-cpp-20250814.1.tar.gz|1692f77d1739bacf3f94337188b78583cf09bab7e420d2dc6c5605a4f86785a1" \
      "https://github.com/mesonbuild/wrapdb/releases/download/abseil-cpp_20250814.1-1/abseil-cpp_20250814.1-1_patch.zip|abseil-cpp_20250814.1-1_patch.zip|f44ad4d72ff2919a6a48cf0887f69aef34c338bfdd8931153596e3766d75f654" \
      "https://github.com/mesonbuild/wrapdb/releases/download/asio_1.30.2-2/asio-1.30.2.tar.gz|asio-1.30.2.tar.gz|12e7bb4dada8bc1191de9d550a59ee658ce4e645ffc97c911c099ab4e8699d55" \
      "https://github.com/mesonbuild/wrapdb/releases/download/asio_1.30.2-2/asio_1.30.2-2_patch.zip|asio_1.30.2-2_patch.zip|8bed3693016874b097e4d902c4ca8daf1b6abf1b5a56b0c5c02827d4e0747ddb" \
      "https://github.com/mesonbuild/wrapdb/releases/download/tomlplusplus_3.4.0-1/tomlplusplus-3.4.0.tar.gz|tomlplusplus-3.4.0.tar.gz|8517f65938a4faae9ccf8ebb36631a38c1cadfb5efa85d9a72e15b9e97d25155" \
    ; do \
      url="${spec%%|*}"; rest="${spec#*|}"; out="${rest%%|*}"; want="${rest#*|}"; ok=0; \
      for i in 1 2 3 4 5; do \
        curl -fsSL --connect-timeout 15 -o "$out" "$url" && { ok=1; break; }; \
        echo "重试 $i/5：$out（github 直连偶发断流）"; sleep 3; \
      done; \
      [ "$ok" = 1 ] || { echo "ERROR: 下载失败 $url"; exit 1; }; \
      echo "$want  $out" | sha256sum -c - || exit 1; \
    done
COPY contrib/tomlutil.py ./contrib/
COPY src ./src

ENV LD_LIBRARY_PATH=/usr/local/nixl/lib64:${LD_LIBRARY_PATH}

# --wrap-mode=nodownload：setup 层零联网（三个 wrap 已在 packagecache）。
# -Drelease_wheel=true 与官方一致（meta 钉 cu12/cu13，见轮子层）。
# （本分支 meson 选项表没有 ucx_path/build_tests 等，未知 -D 直接报错。）
# ccache 走 BuildKit cache mount（uccl_engine/manylinux_uccl/full_cuda12
# 三文件同步）：原生构建与轮子矩阵重复编译的核心库/wrap abseil 缓存复用，
# 同编译器同输入产物 bit 级不变、不进镜像层；需 BuildKit（docker 23+ 默认）。
RUN --mount=type=cache,target=/workspace/.cache/ccache \
    export CCACHE_DIR=/workspace/.cache/ccache CC='ccache gcc' CXX='ccache g++' && \
    ccache -M 20G && \
    rm -rf build && \
    meson setup build \
        --prefix=${NIXL_PREFIX} \
        --buildtype=release \
        --wrap-mode=nodownload \
        -Dnixl_cuda_arch_list=${CUDA_ARCH_LIST} \
        -Denable_plugins=${NIXL_PLUGINS} \
        -Drelease_wheel=true && \
    ninja -j${NPROC:-$(nproc)} -C build && \
    ninja -j${NPROC:-$(nproc)} -C build install && \
    echo "${NIXL_PREFIX}/lib64" > /etc/ld.so.conf.d/nixl.conf && \
    echo "${NIXL_PLUGIN_DIR}" >> /etc/ld.so.conf.d/nixl.conf && \
    ldconfig && \
    ls ${NIXL_PLUGIN_DIR} | grep -q "libplugin_UCCL.so" || \
        { echo "ERROR: missing plugin UCCL"; exit 1; }

# 官方轮子构建脚本单独一层 COPY：只有 build-wheel.sh（或其上层）变化时才重跑
# 下面的轮子层，不牵连前面的原生 meson 构建。
COPY contrib/build-wheel.sh ./contrib/

# Python 绑定轮子：官方 contrib/build-wheel.sh 按 3.10-3.14 全矩阵产出
# manylinux_2_28 平台 tag 的自包含轮子。脚本按 nvcc 报告的 CUDA 大版本
# 定名 nixl-cu12，每版本建一次性 venv 跑 uv build，auditwheel repair 把
# 插件 DT_NEEDED 的引擎库（libuccl_p2p 及传递依赖）vendor 进
# nixl_cu12.libs/。注意：本分支 build-wheel.sh 已无 --ucx-plugins-dir/
# --nixl-plugins-dir 参数与 wheel_add_ucx_plugins.py 后处理——照搬上游
# 调用方式直接失败。对镜像内脚本副本的三处 sed：
# 1) 注入 -Csetup-args 钉插件/架构列表（nvcc 12.4 只到 sm_90）+ nodownload
#    保险（MESON_ARGS 环境变量经 uv build 实测不生效，printf+sed 进
#    BUILD_ARGS）。
# 2) AUDITWHEEL_EXCLUDES 追加 --exclude libpython*：保险丝——libuccl_p2p
#    已按 UCCL 层的 PYTHON_LDFLAGS 覆盖构建、不链 libpython，若上游
#    Makefile 漂移把它带回 DT_NEEDED，宁可留 external 也不 vendor（vendor
#    会与静态链 libpython 的解释器冲突；conda/系统 python 不受影响）。
# 3) UV_PYTHON_PREFERENCE=only-system：配合软链的 /usr/local/bin/python3.X
#    全程零解释器下载；层首对每个请求版本 fail-fast。
# chmod 而非 COPY --chmod=755：tomlutil.py 的 COPY 层在原生 meson 层之前，
# 改它会连带重编整条原生链（Windows 检出 core.filemode=false 无 +x，两处
# 直呼脚本 build-wheel.sh/tomlutil.py 都要补）。
# 冒烟：numpy 是生成 _api.py 的顶层硬依赖、装轮前先装（TUNA）；torch 不装
# （_is_torch_tensor 只查 sys.modules，惰性探测）；轮子本体 --no-deps，依赖
# 留给目标机。目标机自备：libcuda 驱动与 cuFile，以及 libibverbs/libefa
# 等 RDMA 用户态（运行时 dlopen）。meta 轮子由上面原生 meson 构建生成、
# 只随 cu12 产出。
ARG WHL_PYTHON_VERSIONS="3.10,3.11,3.12,3.13,3.14"
ARG UV_PYTHON_PREFERENCE="only-system"
# ccache + uv 双 cache mount（三文件同步；uv 缓存命中每版本 BUILD_DEPS/
# numpy 下载，CC/CXX 经 meson-python 传递、产物不变）。
RUN --mount=type=cache,target=/workspace/.cache/ccache \
    --mount=type=cache,target=/workspace/.cache/uv \
    export CCACHE_DIR=/workspace/.cache/ccache CC='ccache gcc' CXX='ccache g++' && \
    for PYVER in $(echo ${WHL_PYTHON_VERSIONS} | tr ',' ' '); do \
        command -v python${PYVER} >/dev/null || \
            { echo "ERROR: python${PYVER} not on PATH (must be one of the manylinux-bundled /opt/python versions)"; exit 1; }; \
    done && \
    chmod +x contrib/build-wheel.sh contrib/tomlutil.py && \
    printf '        %s\n' \
        "-Csetup-args=--wrap-mode=nodownload" \
        "-Csetup-args=-Dnixl_cuda_arch_list=${CUDA_ARCH_LIST}" \
        "-Csetup-args=-Denable_plugins=${NIXL_PLUGINS}" \
        > /tmp/wheel_setup_args && \
    sed -i '/--no-build-isolation/r /tmp/wheel_setup_args' contrib/build-wheel.sh && \
    grep -q -- "-Csetup-args=-Denable_plugins=${NIXL_PLUGINS}" contrib/build-wheel.sh && \
    rm -f /tmp/wheel_setup_args && \
    sed -i 's/ --exclude liblz4\*/ --exclude liblz4* --exclude libpython*/' contrib/build-wheel.sh && \
    grep -q 'exclude libpython' contrib/build-wheel.sh && \
    export UV_PYTHON_PREFERENCE=${UV_PYTHON_PREFERENCE} && \
    rm -rf dist && mkdir -p dist && \
    for PYVER in $(echo ${WHL_PYTHON_VERSIONS} | tr ',' ' '); do \
        ./contrib/build-wheel.sh \
            --python-version ${PYVER} \
            --platform manylinux_2_28_${ARCH} \
            --output-dir dist || exit 1; \
    done && \
    cp build/src/bindings/python/nixl-meta/nixl-*.whl dist/ && \
    CP_TAG="cp$(echo ${DEFAULT_PYTHON_VERSION} | tr -d .)" && \
    uv pip install numpy && \
    uv pip install --no-deps dist/nixl_cu*-${CP_TAG}-*.whl dist/nixl-*.whl && \
    python${DEFAULT_PYTHON_VERSION} -c "import nixl" && \
    python -c "import glob,zipfile; names=zipfile.ZipFile(glob.glob('dist/nixl_cu*-${CP_TAG}-*.whl')[0]).namelist(); assert any(n.startswith('nixl_cu') and '/_bindings' in n for n in names), 'bindings module missing'; print('wheel OK,', len(names), 'entries; uccl entries:', sum('uccl' in n.lower() for n in names))"
# 冒烟安装：numpy 先单独装（import 硬依赖），轮子本体仍 --no-deps（不拉
# torch，依赖留给目标机按需解决）。

ENV NIXL_PLUGIN_DIR=${NIXL_PLUGIN_DIR}

# 构建产物在 /workspace/nixl/dist：nixl_cu12-*-cp310..cp314-*
# manylinux_2_28_x86_64.whl + meta 轮子 nixl-*-py3-none-any.whl。
LABEL org.opencontainers.image.title="nixl manylinux wheels (UCCL, CUDA 12)"
LABEL org.opencontainers.image.description="Build container producing manylinux_2_28 nixl-cu12 wheels with the UCCL transfer backend"
